{
  "name": "malomatia-flow",
  "version": "1.4.1",
  "description": "Malomatia Flow - turn one sentence into a staged AI engineering pipeline on any agent CLI (Devin, Claude Code, Copilot, Codex, Gemini and more): specialised stages, quality gates, per-stage model routing and a zero-dependency live dashboard.",
  "keywords": [
    "ai",
    "ai-agents",
    "devin",
    "pipeline",
    "workflow",
    "dashboard",
    "developer-tools",
    "zero-dependency",
    "cross-platform"
  ],
  "homepage": "https://github.com/mohmoustafa/MFlow#readme",
  "bugs": "https://github.com/mohmoustafa/MFlow/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohmoustafa/MFlow.git"
  },
  "license": "MIT",
  "author": "Mohammed Mustafa",
  "type": "module",
  "bin": {
    "mflow": "bin/flowforge.mjs",
    "mf": "bin/flowforge.mjs",
    "flowforge": "bin/flowforge.mjs",
    "ff": "bin/flowforge.mjs"
  },
  "files": [
    "bin/",
    "agents/",
    "flows/",
    "skills/",
    "scripts/",
    "dashboard/*.mjs",
    "dashboard/ui/",
    "dashboard/test/",
    "install.mjs",
    "uninstall.mjs",
    "start.mjs",
    "get.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node start.mjs",
    "test": "node dashboard/test/run-tests.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
